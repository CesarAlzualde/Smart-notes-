"""
Servicio para procesamiento OCR (Reconocimiento Óptico de Caracteres).
Permite extraer texto de imágenes y documentos PDF utilizando:
1. Tesseract OCR (implementación básica)
2. Google Vision OCR (implementación avanzada, requiere credenciales API)

Este módulo unifica las interfaces de ambos motores OCR y proporciona
un servicio integrado para la aplicación con manejo de fallos y alternativas.
"""

import os
import logging
import tempfile
import re
from typing import List, Optional
from PIL import Image
import pytesseract
import pdf2image
import io
import numpy as np

# Importaciones para Google Vision OCR
try:
    from google.cloud import vision
    from google.oauth2 import service_account
    GOOGLE_VISION_AVAILABLE = True
except ImportError:
    GOOGLE_VISION_AVAILABLE = False

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Ruta por defecto para las credenciales de Google Vision (ajustada para la nueva estructura)
DEFAULT_CREDENTIALS_PATH = os.path.join(
    os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), 
    "config", 
    "google-vision-key.json"
)

class OCRProcessor:
    """
    Procesador OCR para extraer texto de imágenes y documentos PDF.
    
    Utiliza Tesseract OCR para imágenes y pdf2image + Tesseract para PDFs.
    """
    
    def __init__(self, lang="spa"):
        """
        Inicializa el procesador OCR.
        
        Args:
            lang (str): Idioma para OCR (default: español)
        """
        self.lang = lang
        
        # Definir tipos de archivos soportados
        self.supported_image_types = ['.png', '.jpg', '.jpeg', '.gif', '.bmp', '.tiff', '.webp']
        self.supported_types = self.supported_image_types + ['.pdf']
        
        # Verificar instalación de Tesseract
        try:
            pytesseract.get_tesseract_version()
            logger.info("Tesseract OCR disponible")
        except Exception as e:
            logger.warning(f"Tesseract OCR no disponible: {e}")
            logger.warning("Se utilizará un modo simulado para desarrollo")
            
    def is_supported_filetype(self, filename):
        """
        Verifica si el tipo de archivo es soportado.
        
        Args:
            filename (str): Nombre del archivo a verificar
            
        Returns:
            bool: True si es soportado, False en caso contrario
        """
        ext = os.path.splitext(filename.lower())[1]
        return ext in self.supported_types
        
    def process_file(self, filepath):
        """
        Procesa un archivo y extrae su texto.
        
        Args:
            filepath (str): Ruta al archivo a procesar
            
        Returns:
            str: Texto extraído del archivo
        """
        if not os.path.exists(filepath):
            logger.error(f"Archivo no encontrado: {filepath}")
            return ""
            
        try:
            ext = os.path.splitext(filepath.lower())[1]
            
            # Procesar según tipo de archivo
            if ext == '.pdf':
                return self._process_pdf(filepath)
            elif ext in self.supported_image_types:
                return self._process_image(filepath)
            else:
                logger.error(f"Tipo de archivo no soportado: {ext}")
                return ""
                
        except Exception as e:
            logger.error(f"Error al procesar archivo: {e}")
            return ""
            
    def _process_image(self, image_path):
        """
        Procesa una imagen con OCR.
        
        Args:
            image_path (str): Ruta a la imagen
            
        Returns:
            str: Texto extraído de la imagen
        """
        try:
            # Verificar si Tesseract está disponible
            try:
                pytesseract.get_tesseract_version()
                # Abrir imagen con PIL
                with Image.open(image_path) as img:
                    # Aplicar preprocesamiento básico
                    img = self._preprocess_image(img)
                    
                    # Realizar OCR
                    text = pytesseract.image_to_string(img, lang=self.lang)
                    
                    return text.strip()
            except:
                # Modo simulado para desarrollo/pruebas
                logger.info("Utilizando modo simulado para OCR (Tesseract no disponible)")
                return self._simulate_ocr(image_path)
                
        except Exception as e:
            logger.error(f"Error en OCR de imagen: {e}")
            return ""
            
    def _process_pdf(self, pdf_path):
        """
        Procesa un documento PDF con OCR.
        
        Args:
            pdf_path (str): Ruta al PDF
            
        Returns:
            str: Texto extraído del PDF
        """
        try:
            # Verificar si tenemos las dependencias necesarias
            try:
                # Convertir PDF a imágenes
                images = pdf2image.convert_from_path(
                    pdf_path, 
                    dpi=300,
                    fmt="jpeg",
                    output_folder=tempfile.gettempdir()
                )
                
                # Procesar cada página
                extracted_text = []
                for i, img in enumerate(images):
                    # Preprocesar imagen
                    img = self._preprocess_image(img)
                    
                    # OCR
                    text = pytesseract.image_to_string(img, lang=self.lang)
                    extracted_text.append(text)
                    
                    # Liberar memoria
                    img.close()
                    
                # Combinar texto de todas las páginas
                return "\n\n".join(extracted_text).strip()
                
            except:
                # Modo simulado para desarrollo/pruebas
                logger.info("Utilizando modo simulado para OCR de PDF")
                return self._simulate_ocr(pdf_path, is_pdf=True)
                
        except Exception as e:
            logger.error(f"Error en OCR de PDF: {e}")
            return ""
            
    def _preprocess_image(self, img):
        """
        Preprocesa una imagen para mejorar resultados OCR.
        
        Args:
            img (PIL.Image): Imagen a preprocesar
            
        Returns:
            PIL.Image: Imagen preprocesada
        """
        try:
            # Convertir a escala de grises
            if img.mode != 'L':
                img = img.convert('L')
                
            # Opcional: Ajustar contraste/brillo para mejorar legibilidad
            # Esta parte puede extenderse con algoritmos más sofisticados
            
            return img
            
        except Exception as e:
            logger.error(f"Error en preprocesamiento de imagen: {e}")
            return img  # Devolver imagen original si hay error
            
    def _simulate_ocr(self, file_path, is_pdf=False):
        """
        Simula procesamiento OCR para desarrollo cuando Tesseract no está disponible.
        
        Args:
            file_path (str): Ruta al archivo
            is_pdf (bool): Si el archivo es PDF
            
        Returns:
            str: Texto simulado
        """
        filename = os.path.basename(file_path)
        file_size = os.path.getsize(file_path)
        
        if is_pdf:
            return (
                f"[OCR SIMULADO para PDF: {filename}]\n\n"
                f"Este es un texto simulado para un documento PDF de {file_size} bytes.\n"
                "En un entorno de producción, este texto sería extraído mediante OCR real.\n\n"
                "El documento contiene información importante sobre el tema tratado.\n"
                "Los puntos principales incluyen:\n"
                "- Primer punto de información relevante\n"
                "- Segundo punto con datos adicionales\n"
                "- Conclusiones y recomendaciones\n\n"
                "Para habilitar OCR real, instale Tesseract y las dependencias necesarias."
            )
        else:
            return (
                f"[OCR SIMULADO para imagen: {filename}]\n\n"
                f"Este es un texto simulado para una imagen de {file_size} bytes.\n"
                "En un entorno de producción, este texto sería extraído mediante OCR real.\n\n"
                "La imagen contiene texto que sería procesado por Tesseract OCR.\n"
                "Para habilitar OCR real, instale Tesseract y configure el path adecuadamente."
            )
            with Image.open(image_path) as img:
                # Aplicar preprocesamiento básico
                img = self._preprocess_image(img)
                
                # Realizar OCR
                text = pytesseract.image_to_string(img, lang=self.lang)
                
                return text.strip()
        except:
            # Modo simulado para desarrollo/pruebas
            logger.info("Utilizando modo simulado para OCR (Tesseract no disponible)")
            return self._simulate_ocr(image_path)
                
    except Exception as e:
        logger.error(f"Error en OCR de imagen: {e}")
        return ""
            
def _process_pdf(self, pdf_path):
    """
    Procesa un documento PDF con OCR.
        
    Args:
        pdf_path (str): Ruta al PDF
            
    Returns:
        str: Texto extraído del PDF
    """
    try:
        # Verificar si tenemos las dependencias necesarias
        try:
            # Convertir PDF a imágenes
            images = pdf2image.convert_from_path(
                pdf_path, 
                dpi=300,
                fmt="jpeg",
                output_folder=tempfile.gettempdir()
            )
            
            # Procesar cada página
            extracted_text = []
            for i, img in enumerate(images):
                # Preprocesar imagen
                img = self._preprocess_image(img)
                
                # OCR
                text = pytesseract.image_to_string(img, lang=self.lang)
                extracted_text.append(text)
                
                # Liberar memoria
                img.close()
                
            # Combinar texto de todas las páginas
            return "\n\n".join(extracted_text).strip()
                
        except:
            # Modo simulado para desarrollo/pruebas
            logger.info("Utilizando modo simulado para OCR de PDF")
            return self._simulate_ocr(pdf_path, is_pdf=True)
                
    except Exception as e:
        logger.error(f"Error en OCR de PDF: {e}")
        return ""
            
def _preprocess_image(self, img):
    """
    Preprocesa una imagen para mejorar resultados OCR.
        
    Args:
        img (PIL.Image): Imagen a preprocesar
            
    Returns:
        PIL.Image: Imagen preprocesada
    """
    try:
        # Convertir a escala de grises
        if img.mode != 'L':
            img = img.convert('L')
            
        # Opcional: Ajustar contraste/brillo para mejorar legibilidad
        # Esta parte puede extenderse con algoritmos más sofisticados
            
        return img
            
    except Exception as e:
        logger.error(f"Error en preprocesamiento de imagen: {e}")
        return img  # Devolver imagen original si hay error
            
def _simulate_ocr(self, file_path, is_pdf=False):
    """
    Simula procesamiento OCR para desarrollo cuando Tesseract no está disponible.
        
    Args:
        file_path (str): Ruta al archivo
        is_pdf (bool): Si el archivo es PDF
            
    Returns:
        str: Texto simulado
    """
    filename = os.path.basename(file_path)
    file_size = os.path.getsize(file_path)
    
    if is_pdf:
        return (
            f"[OCR SIMULADO para PDF: {filename}]\n\n"
            f"Este es un texto simulado para un documento PDF de {file_size} bytes.\n"
            "En un entorno de producción, este texto sería extraído mediante OCR real.\n\n"
            "El documento contiene información importante sobre el tema tratado.\n"
            "Los puntos principales incluyen:\n"
            "- Primer punto de información relevante\n"
            "- Segundo punto con datos adicionales\n"
            "- Conclusiones y recomendaciones\n\n"
            "Para habilitar OCR real, instale Tesseract y las dependencias necesarias."
        )
    else:
        return (
            f"[OCR SIMULADO para imagen: {filename}]\n\n"
            f"Este es un texto simulado para una imagen de {file_size} bytes.\n"
            "En un entorno de producción, este texto sería extraído mediante OCR real.\n\n"
            "La imagen contiene texto que sería procesado por Tesseract OCR.\n"
            "Para habilitar OCR real, instale Tesseract y configure el path adecuadamente."
        )
            
def is_google_vision_available(self):
    """
    Verifica si Google Vision API está disponible y configurado correctamente.
        
    Returns:
        bool: True si Google Vision está disponible, False en caso contrario
    """
    try:
        # Verificar si Google Vision está instalado como librería
        if not GOOGLE_VISION_AVAILABLE:
            logger.info("Google Vision no está disponible: librería no instalada")
            return False
            
        # Verificar rutas de credentials
        credentials_path = os.environ.get("GOOGLE_APPLICATION_CREDENTIALS") or DEFAULT_CREDENTIALS_PATH
            
        # Verificar si existe el archivo de credenciales
        if not os.path.isfile(credentials_path):
            # Buscar en "credentials" en lugar de "config"
            # (ajuste para la estructura actual del proyecto)
            credentials_alt = os.path.join(
                os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))),
                "credentials", 
                "google-vision-key.json"
            )
                
            if os.path.isfile(credentials_alt):
                credentials_path = credentials_alt
            else:
                logger.info(f"Google Vision no está disponible: archivo de credenciales no encontrado en {credentials_path}")
                return False
            
        # Intentar inicializar cliente para verificar credenciales
        try:
            credentials = service_account.Credentials.from_service_account_file(credentials_path)
            client = vision.ImageAnnotatorClient(credentials=credentials)
            logger.info("Google Vision disponible y configurado correctamente")
            return True
        except Exception as e:
            logger.error(f"Error al inicializar cliente Google Vision: {e}")
            return False
                
    except Exception as e:
        logger.error(f"Error al verificar disponibilidad de Google Vision: {e}")
        return False
    
def generate_thumbnail(self, image_path, size=(200, 200)):
    """
    Genera una miniatura para una imagen.
        
    Args:
        image_path (str): Ruta a la imagen
        size (tuple): Tamaño de la miniatura (ancho, alto)
            
    Returns:
        str: Ruta a la miniatura generada o None si falla
    """
    try:
        # Verificar que la imagen existe
        if not os.path.exists(image_path):
            logger.error(f"No se puede generar miniatura - imagen no encontrada: {image_path}")
            return None
                
        # Crear directorio de miniaturas si no existe
        thumbnails_dir = os.path.join(os.path.dirname(image_path), "thumbnails")
        os.makedirs(thumbnails_dir, exist_ok=True)
            
        # Generar nombre para la miniatura
        filename = os.path.basename(image_path)
        thumbnail_path = os.path.join(thumbnails_dir, f"thumb_{filename}")
            
        # Crear miniatura con PIL
        with Image.open(image_path) as img:
            img.thumbnail(size)
            img.save(thumbnail_path, "JPEG")
                
        return thumbnail_path
    except Exception as e:
        logger.error(f"Error al generar miniatura: {e}")
        return None


class GoogleVisionOCR:
    """
    Clase para manejar la extracción de texto de imágenes y PDFs usando Google Cloud Vision API.
    Ofrece mayor precisión que Tesseract, especialmente con pizarras, tableros y texto manuscrito.
    """
    
    def __init__(self, credentials_path: Optional[str] = None):
        """
        Inicializa el cliente de Google Vision API.
        
        Args:
            credentials_path: Ruta al archivo JSON de credenciales de Google Cloud.
                              Si es None, se usará la variable de entorno GOOGLE_APPLICATION_CREDENTIALS
                              o la ruta por defecto.
        """
        self.credentials_path = credentials_path or os.getenv("GOOGLE_APPLICATION_CREDENTIALS") or DEFAULT_CREDENTIALS_PATH
        self._init_client()
    
    def _init_client(self):
        """Inicializa el cliente de Google Vision API."""
        try:
            if not os.path.exists(self.credentials_path):
                raise FileNotFoundError(f"Archivo de credenciales no encontrado: {self.credentials_path}")
                
            credentials = service_account.Credentials.from_service_account_file(self.credentials_path)
            self.client = vision.ImageAnnotatorClient(credentials=credentials)
            logger.info(f"Cliente de Google Vision API inicializado con éxito usando: {self.credentials_path}")
        except Exception as e:
            logger.error(f"Error al inicializar Google Vision API: {e}")
            raise
    
    def extract_text_from_image(self, image_path: str) -> str:
        """
        Extrae texto de una imagen usando Google Cloud Vision API.
        
        Args:
            image_path: Ruta a la imagen
            
        Returns:
            Texto extraído
        """
        try:
            # Cargar la imagen
            with io.open(image_path, 'rb') as image_file:
                content = image_file.read()
            
            image = vision.Image(content=content)
            
            # Realizar la detección de texto
            response = self.client.document_text_detection(image=image)
            
            if response.error.message:
                raise Exception(f"Error de Google Vision API: {response.error.message}")
            
            # Extraer todo el texto
            text = response.full_text_annotation.text
            
            # Si no hay texto pero hay anotaciones de texto, combinarlas
            if not text and response.text_annotations:
                text = response.text_annotations[0].description
            
            logger.info(f"Texto extraído con Google Vision: {len(text)} caracteres")
            return text
            
        except Exception as e:
            logger.error(f"Error al extraer texto con Google Vision: {e}")
            raise
    
    def extract_text_from_pdf(self, pdf_path: str) -> str:
        """
        Extrae texto de un PDF convirtiéndolo primero a imágenes y luego usando Google Vision.
        
        Args:
            pdf_path: Ruta al PDF
            
        Returns:
            Texto extraído de todas las páginas
        """
        try:
            # Convertir PDF a imágenes usando pdf2image
            with tempfile.TemporaryDirectory() as temp_dir:
                logger.info(f"Convirtiendo PDF a imágenes: {pdf_path}")
                pdf_pages = pdf2image.convert_from_path(pdf_path, dpi=300)
                
                all_text = []
                for i, page in enumerate(pdf_pages):
                    # Guardar cada página como imagen temporal
                    img_path = os.path.join(temp_dir, f"page_{i+1}.png")
                    page.save(img_path, 'PNG')
                    
                    # Extraer texto de la imagen
                    logger.info(f"Procesando página {i+1} de {len(pdf_pages)}")
                    text = self.extract_text_from_image(img_path)
                    all_text.append(text)
                
                # Combinar el texto de todas las páginas
                full_text = "\n\n".join(all_text)
                logger.info(f"PDF procesado: {len(pdf_pages)} páginas, {len(full_text)} caracteres de texto")
                return full_text
                
        except Exception as e:
            logger.error(f"Error al procesar PDF: {e}")
            raise
    
    def image_to_text(self, file_path: str) -> str:
        """
        Extrae texto de una imagen o PDF.
        
        Args:
            file_path: Ruta al archivo de imagen (JPG, PNG) o PDF
            
        Returns:
            Texto extraído
            
        Raises:
            ValueError: Si el archivo no existe o no es un tipo compatible
            RuntimeError: Si falla el proceso de OCR
        """
        if not os.path.exists(file_path):
            raise ValueError(f"El archivo no existe: {file_path}")
        
        # Determinar el tipo de archivo por extensión
        _, ext = os.path.splitext(file_path.lower())
        
        if ext in ['.jpg', '.jpeg', '.png', '.bmp', '.tiff', '.webp']:
            return self.extract_text_from_image(file_path)
        elif ext == '.pdf':
            return self.extract_text_from_pdf(file_path)
        else:
            raise ValueError(f"Formato de archivo no compatible: {ext}. Se admiten: JPG, PNG, BMP, TIFF, WEBP y PDF")


# Funciones auxiliares para usar Google Vision OCR

def extract_text(file_path: str, credentials_path: Optional[str] = None) -> str:
    """
    Función de conveniencia para extraer texto de una imagen o PDF usando Google Vision.
    
    Args:
        file_path: Ruta al archivo de imagen (JPG, PNG) o PDF
        credentials_path: Ruta al archivo de credenciales de Google Cloud
        
    Returns:
        Texto extraído
    """
    if not GOOGLE_VISION_AVAILABLE:
        logger.warning("Google Vision no está disponible. Instalando módulos necesarios.")
        return "Google Vision API no disponible. Instala google-cloud-vision."
        
    ocr = GoogleVisionOCR(credentials_path)
    return ocr.image_to_text(file_path)


def google_vision_ocr(filepath: str, lang: str = 'es', is_whiteboard: bool = False) -> str:
    """
    Función que mantiene la misma interfaz que image_to_text para
    facilitar la integración con el código existente.
    
    Args:
        filepath: Ruta al archivo de imagen o PDF
        lang: Código de idioma (no usado en Google Vision, se detecta automáticamente)
        is_whiteboard: Si True, optimiza la extracción para pizarras/whiteboards
        
    Returns:
        Texto extraído
    """
    if not GOOGLE_VISION_AVAILABLE:
        logger.warning("Google Vision no está disponible. Usando OCR básico como fallback.")
        basic_ocr = OCRProcessor(lang=lang.replace('es', 'spa'))
        return basic_ocr.process_file(filepath)
        
    try:
        logger.info(f"Procesando archivo con Google Vision OCR: {filepath}")
        
        if is_whiteboard:
            return extract_text_for_whiteboard(filepath)
        else:
            return extract_text(filepath)
            
    except Exception as e:
        logger.error(f"Error en google_vision_ocr: {e}")
        # Fallback a OCR básico en caso de error
        logger.info("Usando OCR básico como fallback después de error en Google Vision")
        try:
            basic_ocr = OCRProcessor(lang=lang.replace('es', 'spa'))
            return basic_ocr.process_file(filepath)
        except:
            return ""


def extract_text_for_whiteboard(file_path: str, credentials_path: Optional[str] = None) -> str:
    """
    Función especializada para extraer texto de pizarras/whiteboards usando Google Vision.
    Usa configuraciones específicas que funcionan mejor con escritura manual y pizarras.
    
    Args:
        file_path: Ruta al archivo de imagen
        credentials_path: Ruta al archivo de credenciales de Google Cloud
        
    Returns:
        Texto extraído optimizado para pizarras
    """
    if not GOOGLE_VISION_AVAILABLE:
        logger.warning("Google Vision no está disponible para procesamiento de pizarras.")
        return "Google Vision API no disponible para procesamiento de pizarras."
        
    logger.info(f"INICIANDO EXTRACCIÓN DE TEXTO PARA PIZARRA en archivo: {file_path}")
    try:
        try:
            ocr = GoogleVisionOCR(credentials_path)
            logger.info("Cliente GoogleVisionOCR inicializado correctamente para pizarra")
        except Exception as client_error:
            logger.error(f"Error al inicializar cliente para pizarra: {client_error}")
            raise
        
        # Cargar la imagen
        try:
            with io.open(file_path, 'rb') as image_file:
                content = image_file.read()
            logger.info(f"Archivo de imagen cargado correctamente: {len(content)} bytes")
            image = vision.Image(content=content)
        except Exception as img_error:
            logger.error(f"Error al cargar imagen para pizarra: {img_error}")
            raise
        
        # Para pizarras, text_detection puede funcionar mejor que document_text_detection
        logger.info("Usando configuración especializada para pizarras/whiteboards")
        try:
            response = ocr.client.text_detection(image=image)
            logger.info("Petición a Google Vision API completada")
        except Exception as api_error:
            logger.error(f"Error en la petición a Google Vision API para pizarra: {api_error}")
            raise
        
        if response.error.message:
            logger.error(f"Error retornado por Google Vision API: {response.error.message}")
            raise Exception(f"Error de Google Vision API: {response.error.message}")
        
        # Extraer y procesar el texto
        if response.text_annotations and len(response.text_annotations) > 0:
            text = response.text_annotations[0].description
            
            # Aplicar algunas mejoras específicas para texto de pizarras
            # Eliminar saltos de línea excesivos
            text = re.sub(r'\n{3,}', '\n\n', text)
            
            logger.info(f"Texto extraído de pizarra con Google Vision: {len(text)} caracteres")
            return text
        else:
            logger.warning("No se encontró texto en la pizarra")
            return ""
            
    except Exception as e:
        logger.error(f"Error al procesar pizarra con Google Vision: {e}")
        return ""


# Interfaz unificada para usar en la aplicación

def process_ocr(filepath: str, engine: str = 'auto', is_whiteboard: bool = False, lang: str = 'es', 
               credentials_path: Optional[str] = None) -> dict:
    """
    Interfaz unificada para procesamiento OCR que selecciona automáticamente el mejor motor disponible.
    
    Args:
        filepath: Ruta al archivo de imagen o PDF a procesar
        engine: Motor OCR a usar ('google', 'tesseract', o 'auto' para selección automática)
        is_whiteboard: Si el contenido es una pizarra o whiteboard (optimización especial con Google Vision)
        lang: Código de idioma ('es' para español, 'en' para inglés)
        credentials_path: Ruta a las credenciales de Google Cloud (sólo para Google Vision)
        
    Returns:
        Diccionario con resultados del OCR y metadatos:
        {
            'text': texto extraído,
            'engine_used': motor OCR utilizado,
            'success': True/False,
            'error': mensaje de error (si hay)
        }
    """
    start_time = time.time()
    result = {
        'text': "",
        'engine_used': "",
        'success': False,
        'error': "",
        'processing_time': 0
    }
    
    try:
        if not os.path.exists(filepath):
            result['error'] = f"Archivo no encontrado: {filepath}"
            return result
            
        # Convertir el código de idioma para compatibilidad con las diferentes bibliotecas
        tesseract_lang = 'spa' if lang == 'es' else lang
        
        # Ajustar la ruta de credenciales por defecto si no se proporciona
        if not credentials_path and engine in ['google', 'auto']:
            credentials_path = DEFAULT_CREDENTIALS_PATH
            
        # Comprobar si se puede usar Google Vision API
        can_use_google = GOOGLE_VISION_AVAILABLE and (
            engine == 'google' or 
            (engine == 'auto' and os.path.exists(credentials_path))
        )
        
        # Intentar primero con Google Vision si está disponible y es adecuado
        if can_use_google:
            try:
                logger.info(f"Intentando procesar {filepath} con Google Vision OCR")
                
                if is_whiteboard:
                    text = extract_text_for_whiteboard(filepath, credentials_path)
                else:
                    text = extract_text(filepath, credentials_path)
                
                if text.strip():
                    result['text'] = text
                    result['engine_used'] = 'google_vision'
                    result['success'] = True
                    logger.info(f"Texto extraído correctamente con Google Vision: {len(text)} caracteres")
                    return result
                else:
                    logger.warning("Google Vision no pudo extraer texto. Probando con Tesseract...")
            except Exception as e:
                logger.error(f"Error con Google Vision OCR: {e}")
                result['error'] = f"Google Vision error: {str(e)}"
                if engine == 'google':  # Si se especificó Google explicitamente, no intentar con Tesseract
                    return result
        elif engine == 'google':
            result['error'] = "Google Vision no está disponible o faltan las credenciales"
            return result
        
        # Usar Tesseract como respaldo o si se especificó
        if engine in ['tesseract', 'auto']:
            try:
                logger.info(f"Procesando {filepath} con Tesseract OCR")
                ocr_processor = OCRProcessor(lang=tesseract_lang)
                text = ocr_processor.process_file(filepath)
                
                if text.strip():
                    result['text'] = text
                    result['engine_used'] = 'tesseract'
                    result['success'] = True
                    logger.info(f"Texto extraído correctamente con Tesseract: {len(text)} caracteres")
                else:
                    result['error'] = "No se pudo extraer texto con ningún motor OCR"
            except Exception as e:
                logger.error(f"Error con Tesseract OCR: {e}")
                result['error'] = f"Tesseract error: {str(e)}"
                
    except Exception as e:
        logger.error(f"Error general en proceso OCR: {e}")
        result['error'] = f"Error general: {str(e)}"
    
    # Calcular tiempo de procesamiento
    result['processing_time'] = time.time() - start_time
    
    return result
